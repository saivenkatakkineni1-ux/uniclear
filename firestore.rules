rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isDepartmentOfficer() {
      return isAuthenticated() && (getUserData().role == 'department_officer' || getUserData().role == 'admin');
    }

    // Test connection doc for initial boot check
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile; admins and officers can read student profiles
      allow read: if isOwner(userId) || isDepartmentOfficer();

      // New users can create their own profile during Sign Up, but MUST be 'student' role
      allow create: if isAuthenticated() 
        && request.auth.uid == userId 
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student';

      // Users can update their profile (e.g. name, department, roll number), but CANNOT change their role
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
        || isAdmin();

      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // Clearance Requests collection
    match /clearance_requests/{requestId} {
      // Students can read their own requests; officers and admins can read all
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid || isDepartmentOfficer()
      );

      // Students can create their own clearance request
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid || isAdmin()
      );

      // Department officers can update department clearance status; admins can update everything; students can update draft
      allow update: if isAuthenticated() && (
        isDepartmentOfficer() || (resource.data.studentUid == request.auth.uid && resource.data.overallStatus == 'pending')
      );

      // Only admins can delete clearance requests
      allow delete: if isAdmin();
    }
  }
}
